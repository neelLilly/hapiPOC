# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: For local DynamoDB development (uncomment to use)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Optional: Drop & recreate tables on setup script run (useful after schema changes)
# DYNAMODB_FORCE_RECREATE=true

# Table Names (optional - defaults provided)
# DYNAMODB_USERS_TABLE=Users
# DYNAMODB_PRODUCTS_TABLE=Products
# DYNAMODB_CARTS_TABLE=Carts
# DYNAMODB_CART_ITEMS_TABLE=CartItems
# DYNAMODB_FAVORITES_TABLE=Favorites

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Configuration
# local | dev | prod
APP_ENV=local

# Node ecosystem mode (optional)
NODE_ENV=development

# Optional bind host override (otherwise derived from APP_ENV)
# HOST=localhost
# HOST=0.0.0.0
PORT=4000

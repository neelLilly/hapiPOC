# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Optional: For local DynamoDB development (uncomment to use)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Table Names (optional - defaults provided)
# DYNAMODB_USERS_TABLE=Users
# DYNAMODB_PRODUCTS_TABLE=Products
# DYNAMODB_CARTS_TABLE=Carts
# DYNAMODB_CART_ITEMS_TABLE=CartItems
# DYNAMODB_FAVORITES_TABLE=Favorites

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Configuration
PORT=4000
